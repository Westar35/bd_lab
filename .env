# Приложение
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
READ_TIMEOUT_SEC=10
WRITE_TIMEOUT_SEC=20

# Сессии и учетная запись администратора
SESSION_KEY=change_me_super_secret_session_key_12345
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# База по умолчанию для новых сессий: postgres или mysql
DEFAULT_DB=postgres

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Fgrths197+
DB_NAME=fleet_db
DB_SSLMODE=disable

# Альтернативная строка подключения (если указана, перекрывает параметры выше)
# DATABASE_URL=postgres://postgres:Fgrths197%2B@localhost:5432/fleet_db?sslmode=disable

# MySQL
# Для локальной установки MySQL используем root-пользователя с паролем,
# который был задан в установщике MySQL.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fleet_db
MYSQL_USER=root
MYSQL_PASSWORD=Fgrths197+
MYSQL_PARSE_TIME=true
MYSQL_LOC=Local

# Автоматический запуск миграций/сидов при старте сервера
AUTO_MIGRATE=true
AUTO_SEED=false
